# Copy to .env for local development: cp .env.example .env

NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000

DATABASE_URL=postgres://flashsale:flashsale@localhost:5433/flashsale
DATABASE_POOL_SIZE=20

REDIS_URL=redis://localhost:6379

# ElasticMQ (SQS-compatible). Credentials are dummies; ElasticMQ ignores them.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
SQS_ENDPOINT=http://localhost:9324
PURCHASE_REQUESTS_QUEUE_URL=http://localhost:9324/000000000000/purchase-requests
PURCHASE_RESULTS_QUEUE_URL=http://localhost:9324/000000000000/purchase-results
