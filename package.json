{
  "name": "flash-sale-demo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "pnpm --filter @flash-sale-demo/shared-types build",
    "infra:up": "docker-compose up -d postgres redis sqs",
    "infra:down": "docker-compose down",
    "stack:up": "docker-compose up -d --build",
    "stack:down": "docker-compose down",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @flash-sale-demo/backend dev:api",
    "dev:worker": "pnpm --filter @flash-sale-demo/backend dev:worker",
    "dev:web": "pnpm --filter @flash-sale-demo/frontend dev",
    "db:migrate": "pnpm --filter @flash-sale-demo/backend db:migrate",
    "db:seed": "pnpm --filter @flash-sale-demo/backend db:seed",
    "stress": "pnpm --filter @flash-sale-demo/backend stress"
  }
}
